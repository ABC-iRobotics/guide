uint8 id
bool use_zone
int32 zone
# Draw this episode's layout from a named seed instead of the scene's episode
# counter, so two evaluations of different policies see IDENTICAL scenes and can be
# compared as paired samples. Reproducible within one simulator session: the seed is
# combined with the scene's master seed, which is drawn from OS entropy at
# registration unless it was injected.
bool use_seed
int32 seed
# Load a fixed start: <task>/config/arrangements/<arrangement>.yaml pins each named Replicator
# distribution it lists to its value for this draw (S3 v2). Empty: a free draw. Not with use_zone.
string arrangement
---
string message
bool success
