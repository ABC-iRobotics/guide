#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "wooden_cabinet"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wooden_cabinet"
{
    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI", "MjcMaterialAPI"]
        )
        {
            uniform double mjc:rollingfriction = 0.1
            uniform double mjc:torsionalfriction = 0.3
            float newton:rollingFriction = 0.1
            float newton:torsionalFriction = 0.3
            float physics:dynamicFriction = 0.95
        }
    }

    def "Geometry"
    {
        def "Body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            over "bottom_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

            over "top_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

