                    point3f physics:localPos0 = (0, 0, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }

                def "base" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "wooden_cabinet_base_vis" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                    )
                    {
                        rel material:binding:physics = </wooden_cabinet/Physics/PhysicsMaterial>
                        uniform int mjc:group = 1
                        uniform double[] mjc:solimp = [0.998, 0.998, 0.001, 0.5, 2]
                        uniform double[] mjc:solref = [0.001, 1]
