#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "glazed_rim_porcelain_ramekin"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "glazed_rim_porcelain_ramekin" (
    prepend apiSchemas = ["GeomModelAPI"]
    assetInfo = {
        string name = "glazed_rim_porcelain_ramekin"
    }
    kind = "component"
    prepend payload = @./Payload/Contents.usda@
)
{
    float3[] extentsHint = [(-0.04466895, -0.04442827, 0.000003), (0.04465087, 0.044665042, 0.043333), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-0.005, -0.005, -0.065), (0.03, 0.03, 0.044999998)]

    over "Geometry"
    {
        over "Body" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "object" (
                prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.00059400185, -0.00010528831, 0.019304277)
                float3 physics:diagonalInertia = (0.00003675552, 0.000023239152, 0.000022557413)
                float physics:mass = 0.038049944
                quatf physics:principalAxes = (-0.019318715, 0.7032387, 0.021813376, 0.7103564)
                custom float physxRigidBody:maxDepenetrationVelocity = 0.1

                over "Box"
                {
