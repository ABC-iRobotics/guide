#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "flat_stove"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "flat_stove"
{
    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI", "MjcMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
        }

        def Material "PhysicsMaterial_1" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI", "MjcMaterialAPI"]
        )
        {
            uniform double mjc:rollingfriction = 0.1
            uniform double mjc:torsionalfriction = 0.3
            float newton:rollingFriction = 0.1
            float newton:torsionalFriction = 0.3
            float physics:dynamicFriction = 0.95
        }
    }

    def "Geometry"
    {
        def "Body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            over "bottom_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

            over "top_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

            over "horizontal_radius_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

            def PhysicsFixedJoint "PhysicsFixedJoint"
            {
                rel physics:body0 = </flat_stove>
                rel physics:body1 = </flat_stove/Geometry/Body>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def "object" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                def PhysicsFixedJoint "PhysicsFixedJoint"
                {
                    rel physics:body0 = </flat_stove/Geometry/Body>
                    rel physics:body1 = </flat_stove/Geometry/Body/object>
                    point3f physics:localPos0 = (0, 0, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }

                def "base" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    def PhysicsFixedJoint "PhysicsFixedJoint"
                    {
                        rel physics:body0 = </flat_stove/Geometry/Body/object>
                        rel physics:body1 = </flat_stove/Geometry/Body/object/base>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }

                    def "burner" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                        over "base_vis" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </flat_stove/Physics/PhysicsMaterial>
                            uniform int mjc:group = 1
                            float newton:contactGap = 0
                            float physics:density = 1000
                        }

                        over "base" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </flat_stove/Physics/PhysicsMaterial>
                            float newton:contactGap = 0
                            float physics:density = 1000
                        }

                        over "collision_burner" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </flat_stove/Physics/PhysicsMaterial>
                            float newton:contactGap = 0
                            float physics:density = 1000
                        }

                        over "cook_region" (
                            prepend apiSchemas = ["MjcSiteAPI"]
                        )
                        {
                        }

                        over "burner" (
                            prepend apiSchemas = ["MjcSiteAPI"]
                        )
                        {
                        }

                        def PhysicsFixedJoint "PhysicsFixedJoint"
                        {
                            rel physics:body0 = </flat_stove/Geometry/Body/object/base>
                            rel physics:body1 = </flat_stove/Geometry/Body/object/base/burner>
                            point3f physics:localPos0 = (0.15, 0, 0)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (1, 0, 0, 0)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                        }

                        def "burner_plate" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                        )
                        {
                            over "burner" (
                                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                            )
                            {
                                rel material:binding:physics = </flat_stove/Physics/PhysicsMaterial>
                                uniform int mjc:group = 1
                                float newton:contactGap = 0
                                uniform token physics:approximation = "convexHull"
                                bool physics:collisionEnabled = 0
                                float physics:density = 1000
                            }

                            def PhysicsFixedJoint "PhysicsFixedJoint"
                            {
                                rel physics:body0 = </flat_stove/Geometry/Body/object/base/burner>
                                rel physics:body1 = </flat_stove/Geometry/Body/object/base/burner/burner_plate>
                                point3f physics:localPos0 = (0, 0, 0)
                                point3f physics:localPos1 = (0, 0, 0)
                                quatf physics:localRot0 = (1, 0, 0, 0)
                                quatf physics:localRot1 = (1, 0, 0, 0)
                            }
                        }
                    }

                    def "button" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (0, 0, 0)
                        float3 physics:diagonalInertia = (1, 1, 1)
                        float physics:mass = 3
                        quatf physics:principalAxes = (1, 0, 0, 0)

                        over "stove_knob_button_vis" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </flat_stove/Physics/PhysicsMaterial_1>
                            uniform int mjc:group = 1
                            uniform double[] mjc:solimp = [0.998, 0.998, 0.001, 0.5, 2]
                            uniform double[] mjc:solref = [0.001, 1]
                            float newton:contactGap = 0
                            uniform token physics:approximation = "convexHull"
                            bool physics:collisionEnabled = 0
                            float physics:density = 100
                        }

                        over "Box" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
