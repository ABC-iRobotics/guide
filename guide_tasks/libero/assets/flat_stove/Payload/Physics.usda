                        }

                        def PhysicsRevoluteJoint "button" (
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:damping = 1
                            uniform token physics:axis = "Z"
                            rel physics:body0 = </flat_stove/Geometry/Body/object/base>
                            rel physics:body1 = </flat_stove/Geometry/Body/object/base/button>
                            point3f physics:localPos0 = (0, 0, 0)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (0.7071068, 0, 0, 0.7071067)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                            float physics:lowerLimit = -0.2864789
