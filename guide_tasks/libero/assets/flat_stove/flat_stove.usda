#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "flat_stove"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "flat_stove" (
    prepend apiSchemas = ["GeomModelAPI"]
    assetInfo = {
        string name = "flat_stove"
    }
    kind = "component"
    prepend payload = @./Payload/Contents.usda@
)
{
    float3[] extentsHint = [(-0.052022096, -0.095, -0.02), (0.245, 0.095, 0.0539), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-0.05, -0.075, -0.095), (0.22500001, 0.095, 0.095)]

    over "Geometry"
    {
        over "Body"
        {
            over "object"
            {
                over "base"
                {
                    over "burner"
                    {
                        over "base"
                        {
                            uniform token purpose = "guide"
                        }

                        over "collision_burner"
                        {
                            uniform token purpose = "guide"
                        }

                        over "burner_plate"
                        {
                            over "burner" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </flat_stove/Materials/guide_burner>
                            }
                        }

                        over "base_vis" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </flat_stove/Materials/guide_body>
                        }
                    }

                    over "button"
                    {
                        over "Box"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_1"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_2"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_3"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_4"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_5"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_6"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_7"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_8"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_9"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_10"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_11"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_12"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_13"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_14"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_15"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_16"
                        {
                            uniform token purpose = "guide"
                        }

                        over "Box_17"
                        {
                            uniform token purpose = "guide"
                        }

                        over "stove_knob_button_vis" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </flat_stove/Materials/guide_knob>
                        }
                    }
                }
            }
        }
    }

    over "Materials"
    {
        def Material "guide_burner"
        {
            token outputs:mdl:displacement.connect = </flat_stove/Materials/guide_burner/Shader.outputs:out>
            token outputs:mdl:surface.connect = </flat_stove/Materials/guide_burner/Shader.outputs:out>
            token outputs:mdl:volume.connect = </flat_stove/Materials/guide_burner/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.4, 0.4, 0.4)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.45
                token outputs:out
            }
        }

        def Material "guide_body"
        {
            token outputs:mdl:displacement.connect = </flat_stove/Materials/guide_body/Shader.outputs:out>
            token outputs:mdl:surface.connect = </flat_stove/Materials/guide_body/Shader.outputs:out>
            token outputs:mdl:volume.connect = </flat_stove/Materials/guide_body/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.4, 0.4, 0.4)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.45
                token outputs:out
            }
        }

        def Material "guide_knob"
        {
            token outputs:mdl:displacement.connect = </flat_stove/Materials/guide_knob/Shader.outputs:out>
            token outputs:mdl:surface.connect = </flat_stove/Materials/guide_knob/Shader.outputs:out>
            token outputs:mdl:volume.connect = </flat_stove/Materials/guide_knob/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.15, 0.15, 0.15)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.35
                token outputs:out
            }
        }
    }
}

