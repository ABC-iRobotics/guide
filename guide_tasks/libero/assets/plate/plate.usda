#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "plate"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "plate" (
    prepend apiSchemas = ["GeomModelAPI"]
    assetInfo = {
        string name = "plate"
    }
    kind = "component"
    prepend payload = @./Payload/Contents.usda@
)
{
    float3[] extentsHint = [(-0.0686215, -0.068486, -0.0025131851), (0.06962803, 0.06908259, 0.016631), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-0.005, -0.005, -0.065), (0.03, 0.03, 0.044999998)]

    over "Geometry"
    {
        over "Body" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "object" (
                prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.00019482894, 0.0018705128, 0.007571184)
                float3 physics:diagonalInertia = (0.00006499961, 0.000033801683, 0.000031966196)
                float physics:mass = 0.03048326
                quatf physics:principalAxes = (0.49387708, 0.49932933, -0.5007634, 0.5059562)
                custom float physxRigidBody:maxDepenetrationVelocity = 0.1

                over "Box"
                {
                    uniform token purpose = "guide"
                }

                over "Box_1"
                {
                    uniform token purpose = "guide"
                }

                over "Box_2"
                {
                    uniform token purpose = "guide"
                }

                over "Box_3"
                {
                    uniform token purpose = "guide"
                }

                over "Box_4"
                {
                    uniform token purpose = "guide"
                }

                over "Box_5"
                {
                    uniform token purpose = "guide"
                }

                over "Box_6"
                {
                    uniform token purpose = "guide"
                }

                over "Box_7"
                {
                    uniform token purpose = "guide"
                }

                over "Box_8"
                {
                    uniform token purpose = "guide"
                }

                over "Box_9"
                {
                    uniform token purpose = "guide"
                }

                over "PhysicsFixedJoint"
                {
                    bool physics:jointEnabled = 0
                }

                over "model_vis" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </plate/Materials/guide_glaze>
                }
            }

            over "PhysicsFixedJoint"
            {
                bool physics:jointEnabled = 0
            }
        }
    }

    over "Materials"
    {
        def Material "guide_glaze"
        {
            token outputs:mdl:displacement.connect = </plate/Materials/guide_glaze/Shader.outputs:out>
            token outputs:mdl:surface.connect = </plate/Materials/guide_glaze/Shader.outputs:out>
            token outputs:mdl:volume.connect = </plate/Materials/guide_glaze/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR_ClearCoat.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR_ClearCoat"
                float inputs:clearcoat_reflection_roughness = 0.03
                float inputs:clearcoat_weight = 0.03
                asset inputs:diffuse_texture = @./Payload/Textures/texture.png@
                bool inputs:enable_clearcoat = 1
                float inputs:reflection_roughness_constant = 0.25
                token outputs:out
            }
        }
    }
}

