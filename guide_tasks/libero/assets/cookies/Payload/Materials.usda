#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "cookies"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cookies"
{
    def Scope "Materials"
    {
        def Material "cookies" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/cookies>
        )
        {
        }
    }

    over "Geometry"
    {
        over "Body"
        {
            over "object"
            {
                over "cookies_vis" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </cookies/Materials/cookies>
                }
            }
        }
    }
}

