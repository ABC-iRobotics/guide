#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "cookies"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cookies" (
    prepend apiSchemas = ["GeomModelAPI"]
    assetInfo = {
        string name = "cookies"
    }
    kind = "component"
    prepend payload = @./Payload/Contents.usda@
)
{
    float3[] extentsHint = [(-0.03104, -0.041810673, -0.01003818), (0.03104, 0.041810706, 0.010037905), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-0.005, -0.005, -0.065), (0.03, 0.03, 0.044999998)]

    over "Geometry"
    {
        over "Body" (
            delete apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "object" (
                prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.0000698567, 0.0002435232, 0.00013419826)
                float3 physics:diagonalInertia = (0.000016670501, 0.000011258249, 0.0000065416816)
                float physics:mass = 0.01905736
                quatf physics:principalAxes = (0.50214654, 0.4980303, -0.50016856, 0.49964598)
                custom float physxRigidBody:maxDepenetrationVelocity = 0.1

                over "Box"
                {
                    uniform token purpose = "guide"
                }

                over "PhysicsFixedJoint"
                {
                    bool physics:jointEnabled = 0
                }

                over "cookies_vis" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </cookies/Materials/guide_print>
                }
            }

            over "PhysicsFixedJoint"
            {
                bool physics:jointEnabled = 0
            }
        }
    }

    over "Materials"
    {
        def Material "guide_print"
        {
            token outputs:mdl:displacement.connect = </cookies/Materials/guide_print/Shader.outputs:out>
            token outputs:mdl:surface.connect = </cookies/Materials/guide_print/Shader.outputs:out>
            token outputs:mdl:volume.connect = </cookies/Materials/guide_print/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                asset inputs:diffuse_texture = @./Payload/Textures/texture_map.png@
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.75
                float inputs:specular_level = 0.3
                token outputs:out
            }
        }
    }
}

