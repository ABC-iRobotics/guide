<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cube_stack</name>
  <version>2.0.0</version>
  <description>GUIDE demonstration task: stack the cubes of the block_bin scene in a random order.</description>
  <maintainer email="makany.andras@uni-obuda.hu">András Makány</maintainer>
  <license>GPL-3.0-only</license>

  <!-- The scene: the block_bin USD, loaded from block_bin's install. -->
  <depend>block_bin</depend>
  <depend>guide_core</depend>
  <depend>guide_ex</depend>
  <depend>guide_msgs</depend>
  <depend>irob_lerobot_ros</depend>
  <exec_depend>franka_fr3_moveit_config</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
