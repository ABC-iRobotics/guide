format: "xrdf"

format_version: 2.0

default_joint_positions: 
  fr3_joint1: 0.0
  fr3_joint2: -0.7854
  fr3_joint3: 0.0
  fr3_joint4: -2.3562
  fr3_joint5: 0.0
  fr3_joint6: 1.5708
  fr3_joint7: 0.7854
  fr3_finger_joint1: 0.0

cspace: 
  joint_names: 
    - "fr3_joint1"
    - "fr3_joint2"
    - "fr3_joint3"
    - "fr3_joint4"
    - "fr3_joint5"
    - "fr3_joint6"
    - "fr3_joint7"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [10000.0, 10000.0, 10000.0, 10000.0, 10000.0, 10000.0, 10000.0]

world_collision: 
  geometry: "auto_generated_collision_sphere_group"

self_collision: 
  geometry: "auto_generated_collision_sphere_group"
  ignore: 
    fr3_link0: 
      - "fr3_link1"
    fr3_link1: 
      - "fr3_link2"
    fr3_link2: 
      - "fr3_link3"
    fr3_link3: 
      - "fr3_link4"
    fr3_link4: 
      - "fr3_link5"
    fr3_link5: 
      - "fr3_link6"
    fr3_link6: 
      - "fr3_link7"
    fr3_link7: 
      - "fr3_link8"
    fr3_link8: 
      - "fr3_hand"
    fr3_hand: 
      - "fr3_leftfinger"
      - "fr3_rightfinger"
      - "fr3_hand_tcp"
    fr3_leftfinger: 
      - "fr3_rightfinger"
      - "fr3_hand_tcp"
    fr3_rightfinger: 
      - "fr3_hand_tcp"

